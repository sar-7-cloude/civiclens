# ------------------------------------------------------------------
# CivicLens environment configuration
# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
# ------------------------------------------------------------------

# Get a FREE Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
# Never commit your real .env file or share this key.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for classification / insights / summaries.
# NOTE: there is no model called "gemini-3.6-flash".
#   - "gemini-2.5-flash"  -> stable, free-tier friendly (DEFAULT)
#   - "gemini-3.7-flash"  -> newer generation, if available on your key
#   "gemini-2.0-flash" has been shut down by Google - do not use it.
GEMINI_MODEL=gemini-2.5-flash

# Port for the local Express server
PORT=3000
